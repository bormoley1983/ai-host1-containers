model_list:

  # ============================================================
  # GEMMA 4 26B
  # Fast daily agent / general work
  # Backend: Ollama
  # ============================================================
  - model_name: local-gemma4:26B-128K
    litellm_params:
      model: ollama_chat/gemma4:26b
      api_base: http://192.168.100.49:11434

      num_ctx: 131072
      num_predict: 2048

      temperature: 1.0
      top_p: 0.95
      top_k: 64

      think: true
      timeout: 1200

    model_info:
      max_input_tokens: 122880
      max_output_tokens: 2048

      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true

  # ============================================================
  # QWEN 3.8 27B
  # Primary coding / repository / agent model
  # Backend: llama.cpp
  #
  # Sampling defaults are configured in llama.cpp.
  # ============================================================
  - model_name: local-qwen3.8:27B-128K
    litellm_params:
      model: openai/local-qwen3.8:27B-128K
      api_base: http://192.168.100.49:8080/v1
      api_key: dummy

      timeout: 1200

    model_info:
      max_input_tokens: 122880
      max_output_tokens: 4096

      supports_function_calling: true
      supports_reasoning: false
      supports_vision: false

  # ============================================================
  # GEMMA 4 31B QAT
  # Deeper / slower reasoning and coding
  # Backend: Ollama
  # ============================================================
  - model_name: local-gemma4:31B-QAT-72K
    litellm_params:
      model: ollama_chat/gemma4:31b-it-qat
      api_base: http://192.168.100.49:11434

      num_ctx: 73728
      num_predict: 3072

      temperature: 1.0
      top_p: 0.95
      top_k: 64

      think: true
      timeout: 1200

    model_info:
      max_input_tokens: 65536
      max_output_tokens: 3072

      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true

  # ============================================================
  # META MUSE GLIMMER 30B
  # Agent / tool-use / coding comparison model
  # Backend: Ollama
  # ============================================================
  - model_name: local-muse-glimmer:30B-128K
    litellm_params:
      model: ollama_chat/muse-glimmer:30b
      api_base: http://192.168.100.49:11434

      num_ctx: 131072
      num_predict: 4096

      temperature: 1.0
      top_p: 0.95
      top_k: 64

      think: true
      timeout: 1200

    model_info:
      max_input_tokens: 122880
      max_output_tokens: 4096

      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true

litellm_settings:
  drop_params: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY

router_settings:
  num_retries: 1
  timeout: 1200
  cooldown_time: 30
  allowed_fails: 2
